{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 2,
      "right": 2,
    },
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " ",
      "keyColor": "blue",
    },
    {
      "type": "kernel",
      "key": "󰌽 ",
      "keyColor": "magenta",
    },
    {
      "type": "packages",
      "key": "󰏗 ",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "󱆃 ",
      "keyColor": "green",
    },
    "break",
    {
      "type": "wm",
      "key": "󱂬 ",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "󰆍 ",
      "keyColor": "magenta",
    },
    "break",
    {
      "type": "cpu",
      "key": "󰍛 ",
      "keyColor": "blue",
      "showPeCoreCount": true,
      "temp": true,
    },
    {
      "type": "gpu",
      "key": "󰢮 ",
      "keyColor": "magenta",
    },
    {
      "type": "memory",
      "key": "  ",
      "keyColor": "yellow",
      "format": "{} / {} ({3})",
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "green",
    },
    "break",
    {
      "type": "battery",
      "key": "󰁹 ",
      "keyColor": "green",
    },

    "break",
    {
      "type": "localip",
      "key": "󰩟 ",
      "keyColor": "red",
    },

    "break",
    "colors",
  ],
}
