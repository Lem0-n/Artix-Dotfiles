{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 1,
  "margin": 0,
  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/count-updates",
    "group/hardware",
    "wireplumber#sink",
    "backlight",
    "network",
    "battery",
  ],
  "hyprland/workspaces": {
    "format": "{name}",
  },
  "hyprland/window": {
    "format": "<span color='#FFE6A7'>  {title}</span>",
  },
  "custom/count-updates": {
    "format": "<span font='Iosevka NFM 11'>{}</span>",
    "interval": 60,
    "exec": "~/.config/waybar/scripts/count-updates.sh",
    "on-click": "kitty -e sudo pacman -Syu",
    "tooltip": false,
  },
  "group/hardware": {
    "orientation": "horizontal",
    "modules": ["cpu", "temperature", "disk"],
  },
  "clock": {
    "format": "󰥔{:%H:%M:%S %B %d, %Y}",
    "format-alt": "󰥔  {:%H:%M:%S}",
    "tooltip-format": "<span font='Iosevka NFM 11'> <big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt></span>",
    "interval": 1,
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span font='Iosevka NFM 10' color='#d3c6aa'><b>{}</b></span>",
        "days": "<span font='Iosevka NFM 10' color='#e67e80'>{}</span>",
        "weeks": "<span font='Iosevka NFM 10' color='#a7c080'><b>W{}</b></span>",
        "weekdays": "<span font='Iosevka NFM 10' color='#7fbbb3'><b>{}</b></span>",
        "today": "<span font='Iosevka NFM 10' color='#dbbc7f'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
  "cpu": {
    "format": "󰘚 {usage}%",
    "tooltip": true,
    "interval": 1,
    "on-click": "ghostty -e btop",
  },
  "memory": {
    "format": "󰍛 {}%",
    "interval": 1,
    "on-click": "ghostty -e btop",
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-alt": "{icon} {temperatureF}°F",
    "format-icons": ["󱃃", "󰔏", "󱃂"],
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
  },
  "network": {
    "format-wifi": "󰖩 {essid} ({signalStrength}%)",
    "format-ethernet": "󰈀 {ifname}",
    "format-linked": "󰈀 {ifname} (No IP)",
    "format-disconnected": "󰖪 Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{ifname}: {ipaddr}",
  },
  "wireplumber#sink": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": ["", "", ""],
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-rightc": "pavucontrol",
    "on-scroll-down": "wpctl set-volume @DEFAULT_SINK@ 1%-",
    "on-scroll-up": "wpctl set-volume @DEFAULT_SINK@ 1%+",
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
  },
  "disk": {
    "interval": 30,
    "format": "󰋊 {percentage_used}%",
    "path": "/",
  },
}
